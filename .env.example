# ---------------------------------------------------------------------------
# Template variabili d'ambiente — copiare in .env e compilare
# Generare SECRET_KEY con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ---------------------------------------------------------------------------

# --- Sicurezza ---
SECRET_KEY=cambia-con-una-chiave-segreta-generata
DEBUG=False
ALLOWED_HOSTS=documentale.esempio.it,192.168.1.100
CSRF_TRUSTED_ORIGINS=https://documentale.esempio.it

# --- HTTPS (abilitare quando il server ha SSL) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# --- Database PostgreSQL ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=documentale
DB_USER=documentale_user
DB_PASSWORD=cambia-con-password-sicura
DB_HOST=localhost
DB_PORT=5432

# --- Demo / Sanatoria (disabilitare in produzione normale) ---
DOCUMENTALE_DEMO_MODE=false
DOCUMENTALE_DEMO_SUPERVISOR_USERNAME=supervisor_demo

# --- Email (relay SMTP aziendale, nessuna credenziale richiesta) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=elthub-it.mail.protection.outlook.com
EMAIL_PORT=25
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@elthub.it
